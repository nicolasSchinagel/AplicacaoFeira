<div class="lista-outsides">
    <div class="track">
        <div class="outside active">
            <div class="banner-feira">
                <img src="~/img/back-fut.png" alt="Banner Futebol" class="banner-image">
                <a class="banner-button1" asp-controller="Home" asp-action="Cultura">
                    <h2 class="text-banner-button">Saiba mais</h2>
                    <img src="~/img/fut-ball.png" alt="logo botão" class="logo-banner-button">
                </a>
            </div>
        </div>

        <div class="outside">
            <div class="banner-feira">
                <img src="~/img/image-back2.webp" alt="Banner Comida" class="banner-image">
                <a class="banner-button2" asp-controller="Home" asp-action="Culinaria">
                    <h2 class="text-banner-button2">Explorar</h2>
                    <img src="~/img/taco.png" alt="logo botão" class="logo-banner-button">
                </a>
            </div>
        </div>
        <div class="outside">
            <div class="banner-feira">
                <img src="~/img/back-music.webp" alt="Banner Arte" class="banner-image">
                <a class="banner-button3" asp-controller="Home" asp-action="Cultura">
                    <h2 class="text-banner-button3">Explorar</h2>
                    <img src="~/img/music-banner-icon.png" alt="logo botão" class="logo-banner-button">
                </a>
            </div>
        </div>
    </div>
    <div class="arrows">
        <img src="~/img/arrow-right.png" class="banner-next">
        <img src="~/img/arrow-left.png" class="banner-prev">
    </div>
</div>