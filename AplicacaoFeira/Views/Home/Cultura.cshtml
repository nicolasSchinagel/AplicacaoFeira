    <script>
                           const blocos = document.querySelectorAll(".bloco-music");

        blocos.forEach(bloco => {

            const botao = bloco.querySelector(".icon-play");
            const musica = bloco.querySelector(".musica-files");
            const barra = bloco.querySelector(".line-played");
            const barraGeral = bloco.querySelector(".line-general");

            botao.addEventListener("click", () => {

                // Para todas as outras músicas
                document.querySelectorAll(".musica-files").forEach(audio => {

                    if (audio !== musica) {
                        audio.pause();
                        audio.currentTime = 0;
                    }

                });

                // Reseta todos os ícones
                document.querySelectorAll(".icon-play").forEach(img => {
                    img.src = "/img/play.png";
                });

                // Reseta todas as barras
                document.querySelectorAll(".line-played").forEach(linha => {
                    if (linha !== barra) {
                        linha.style.width = "0%";
                    }
                });

                if (musica.paused) {

                    musica.play();
                    botao.src = "/img/pause.png";

                } else {

                    musica.pause();
                    botao.src = "/img/play.png";

                }

            });

            musica.addEventListener("timeupdate", () => {

                if (!isNaN(musica.duration) && musica.duration > 0) {

                    const porcentagem =
                        (musica.currentTime / musica.duration) * 100;

                    barra.style.width = porcentagem + "%";
                }

            });

            musica.addEventListener("ended", () => {

                botao.src = "/img/play.png";
                barra.style.width = "0%";

            });

            barraGeral.addEventListener("click", (e) => {

                if (isNaN(musica.duration)) return;

                const largura = barraGeral.clientWidth;
                const position = e.offsetX;

                const porcentagem = position / largura;

                musica.currentTime = musica.duration * porcentagem;

            });

            // Apenas para descobrir erros
            musica.addEventListener("error", () => {

                console.log("Erro ao carregar:", musica.currentSrc);

            });

        });
    </script>