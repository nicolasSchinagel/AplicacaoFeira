<div class="fundo-form">
        <img src="~/img/background-register.webp" class="background-registro">
        <section class="blanket-registro">
            <h1 class="title-cadastro">CADASTRO DO CLIENTE</h1>
            <form class="formulario-emSi">
             <div class="input-2-geral">
                <label class="label-input-1">Nome <span class="obrigatorio">*</span></label>
                <div class="input-box">
                    <img src="~/img/name-image.webp" class="icon-input-1">
                    <input type="text" placeholder="Digite seu nome" class="input-login-1">
                </div>
             </div>
             <div class="input-2-geral">
                <label class="label-input-1">Email <span class="obrigatorio">*</span></label>
                <div class="input-box">
                    <img src="~/img/Email-image.webp" class="icon-input-1">
                    <input type="email" placeholder="senhor@gmail.com" class="input-login-1">
                </div>
             </div>
             <div class="input-2-geral">
                <label class="label-input-1">Senha <span class="obrigatorio">*</span></label>
                <div class="input-box">
                    <img src="~/img/Code-image.webp" class="icon-input-1">
                    <input type="password" placeholder="Senha de pelo menos 5 dígitos" class="input-login-1">
                </div>
             </div>
             <div class="input-2-geral">
                <label class="label-input-1">Confirmação da senha <span class="obrigatorio">*</span></label>
                <div class="input-box">
                    <img src="~/img/confirm-image.webp" class="icon-input-1">
                    <input type="password" placeholder="Digite a senha novamente" class="input-login-1">
                </div>
             </div>
             <button class="button-login-2">
                CADASTRAR
             </button>
           </form>
        </section>
    </div>